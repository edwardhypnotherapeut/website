---
import { href } from '../lib/content';
import Icon from './Icon.astro';

interface Props {
  title: string;
  description: string;
  path: string;
  label: string;
  level?: 'h2' | 'h3';
}

const { title, description, path, label, level = 'h3' } = Astro.props;
const Heading = level;
---

<a class="issue-card" href={href(path)}>
  <Heading>
    {title}
    <Icon name="arrow-right" size={15} />
  </Heading>
  <p>{description}</p>
  <span class="sr-only">{label}</span>
</a>
