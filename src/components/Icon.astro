  'arrow-up-right': '<path d="M7 17 17 7"/><path d="M8 7h9v9"/>',
  check: '<path d="m4.5 12.5 4.5 4.5L19.5 6.5"/>',
  'chevron-down': '<path d="m6 9 6 6 6-6"/>',
  globe:
    '<circle cx="12" cy="12" r="9"/><path d="M3 12h18"/><path d="M12 3c2.5 2.6 3.8 5.7 3.8 9S14.5 18.4 12 21c-2.5-2.6-3.8-5.7-3.8-9S9.5 5.6 12 3Z"/>',
  phone:
    '<path d="M6.6 3.5h2.9l1.4 4-2 1.4a12.3 12.3 0 0 0 6.2 6.2l1.4-2 4 1.4v2.9a2 2 0 0 1-2.2 2A17.6 17.6 0 0 1 4.6 5.7a2 2 0 0 1 2-2.2Z"/>',
  mail: '<rect x="3" y="5" width="18" height="14" rx="2.5"/><path d="m4 7 8 6 8-6"/>',
  whatsapp:
    '<path d="M20 11.6A8 8 0 0 1 8.1 18.7L4 20l1.4-4A8 8 0 1 1 20 11.6Z"/><path d="M9.2 8.6c.2-.4.5-.4.8-.4h.4c.2 0 .4.1.5.4l.7 1.6c.1.2 0 .4-.1.6l-.5.6c-.1.2-.2.3 0 .6.4.7 1 1.3 1.7 1.7.3.2.5.1.6 0l.6-.6c.2-.2.4-.2.6-.1l1.5.7c.3.1.4.3.4.5 0 .4-.2 1.2-.6 1.5-.4.3-1 .6-1.7.5-1.2-.2-2.9-.9-4.4-2.4-1.5-1.5-2.2-3.2-2.4-4.4-.1-.7.2-1.3.5-1.7Z"/>',
  'map-pin':
    '<path d="M12 21s7-5.5 7-11a7 7 0 1 0-14 0c0 5.5 7 11 7 11Z"/><circle cx="12" cy="10" r="2.5"/>',
  clock: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>',
  instagram:
    '<rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.2" cy="6.8" r="1" fill="currentColor" stroke="none"/>',
  linkedin:
    '<rect x="3" y="3" width="18" height="18" rx="3"/><path d="M8 10.5V17"/><circle cx="8" cy="7.4" r="0.9" fill="currentColor" stroke="none"/><path d="M12 17v-3.8a2.6 2.6 0 0 1 5.2 0V17"/>',
  facebook:
    '<path d="M13.8 21v-7h2.3l.5-3h-2.8V9.2c0-.9.3-1.5 1.6-1.5H17V5.1c-.3 0-1.2-.1-2.2-.1-2.2 0-3.7 1.3-3.7 3.8V11H8.8v3h2.3v7"/>',
  star: '<path d="m12 3.5 2.6 5.3 5.9.9-4.3 4.2 1 5.8-5.2-2.7-5.2 2.7 1-5.8L3.5 9.7l5.9-.9Z" fill="currentColor" stroke="none"/>',
  arch: '<path d="M6 20V11a6 6 0 0 1 12 0v9"/><path d="M12 20v-6"/><circle cx="12" cy="8" r="1.5" fill="currentColor" stroke="none"/>',
  shield: '<path d="M12 3 5 6v5c0 4.5 3 8 7 10 4-2 7-5.5 7-10V6l-7-3Z"/><path d="m9 12 2 2 4-4"/>',
  users:
    '<circle cx="9" cy="8" r="3"/><path d="M3.5 20a5.5 5.5 0 0 1 11 0"/><path d="M16 5.2a3 3 0 0 1 0 5.6"/><path d="M17 14.5a5.5 5.5 0 0 1 3.5 5.5"/>',
  calendar: '<rect x="3.5" y="5" width="17" height="15" rx="2.5"/><path d="M3.5 9.5h17M8 3.5v3M16 3.5v3"/>',
  heart: '<path d="M12 20s-7-4.4-7-9a4 4 0 0 1 7-2.6A4 4 0 0 1 19 11c0 4.6-7 9-7 9Z"/>',
  sparkle:
    '<path d="M12 3v3.5M12 17.5V21M3 12h3.5M17.5 12H21M6 6l2.3 2.3M15.7 15.7 18 18M18 6l-2.3 2.3M8.3 15.7 6 18"/>',
};

const inner = icons[name] ?? icons.check!;
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  style={style}
  aria-hidden="true"
  focusable="false"
  set:html={inner}
/>
