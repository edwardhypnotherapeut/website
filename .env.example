# Deployment settings (copy to .env for local production builds)

# Full public URL of the deployment. For GitHub project pages use the origin
# only, e.g. https://username.github.io — the path goes in BASE_PATH.
SITE_URL=https://edwardhypnotherapeut.github.io

# Path the site is served from: / for a domain, /website for project pages.
BASE_PATH=/website
